# =====================================================
#  백업 스크립트 설정 — 틀(예시) 파일
# =====================================================
#
#  이 파일은 "어떤 값이 필요한지"만 적어둔 것입니다.
#  실제 값이 없으므로 git 에 커밋해도 안전합니다.
#
#  실제 파일은 WSL 리눅스 쪽에 둡니다:
#      ~/site-backup/.env      (권한 600)
#
#  왜 프로젝트 폴더에 두지 않는가:
#    /mnt 아래(Windows 파일)는 리눅스 권한이 적용되지 않습니다.
#    전부 777 로 표시되어 chmod 600 을 걸어도 소용이 없습니다.
#    비밀을 담는 파일은 리눅스 파일시스템(~/)에 둬야 보호됩니다.
# =====================================================


# Supabase DB 연결 문자열
#
#   대시보드 → Connect → Session pooler 또는 Direct connection
#   [YOUR-PASSWORD] 부분을 실제 비밀번호로 바꿔 넣습니다.
#
#   🔒 이 비밀번호는 postgres 관리자 계정 것입니다.
#      RLS 정책을 전부 우회하고 모든 데이터를 읽을 수 있습니다.
#      절대 커밋·공유·캡처하지 마세요.
SUPABASE_DB_URL="postgresql://postgres.프로젝트ID:비밀번호@호스트:5432/postgres"


# 백업 파일을 남겨둘 기간 (일). 지난 것은 자동 삭제됩니다.
KEEP_DAYS=30


# -----------------------------------------------------
#  Storage(이미지) 백업을 붙일 때 추가할 값 — 아직 사용 안 함
# -----------------------------------------------------
#
#   Storage → S3 메뉴에서 발급
#   🔒 이것도 강력한 자격증명입니다. 버킷의 파일을 마음대로
#      읽고 쓰고 지울 수 있으며 정책을 우회합니다.
#
# S3_ENDPOINT="https://프로젝트ID.supabase.co/storage/v1/s3"
# S3_REGION="ap-northeast-2"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
